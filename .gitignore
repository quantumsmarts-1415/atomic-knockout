node_modules/
dist/
game-dist/
release/
.DS_Store

# Built Windows .exe files stay out of git. latest.json may point at Google Drive.
site/downloads/*
!site/downloads/.gitkeep
!site/downloads/latest.json

# Regenerated by npm run branding:icons
branding/cover-1024.png

# Blender pipeline: per-frame renders are regenerable from hydra.blend.
# The composed previews in out/ and the sheets in out/sheets/ are kept.
tools/blender/out/_tmp/
tools/blender/*.blend1

# Python bytecode from Blender running the pipeline scripts
tools/blender/__pycache__/
